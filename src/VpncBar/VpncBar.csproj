<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VpncBar</RootNamespace>
    <AssemblyName>VpncBar</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <ApplicationIcon>assets\VpncBar.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- WinForms dark mode (Application.SetColorMode) is still marked experimental -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
    <!-- Single exe, three modes: tray (default) | service | script. See docs/PORTING.md §3. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceBase for the same exe's service mode (no generic-host stack) -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon art: colors are parsed from these at runtime (TrayIcons) -->
    <EmbeddedResource Include="assets\vpn-on.svg" />
    <EmbeddedResource Include="assets\vpn-off.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled backends → output\openconnect\ (wintun.dll beside the exe so it loads it) -->
    <None Include="..\..\vendor\openconnect\bin\**" LinkBase="openconnect" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\wintun\bin\amd64\wintun.dll" Link="openconnect\wintun.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\vpncbar-script.js" Link="vpncbar-script.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
