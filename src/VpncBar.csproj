<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VpncBar</RootNamespace>
    <AssemblyName>VpncBar</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <ApplicationIcon>assets\VpncBar.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- WinForms dark mode (Application.SetColorMode) is still marked experimental -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
    <!-- Single exe, three modes: tray (default) | service | script. -->

    <Company>VpncBar</Company>
    <Product>VpncBar</Product>
    <AssemblyTitle>VpncBar</AssemblyTitle>
    <!-- Dev builds (dotnet build) are framework-dependent, output at
         bin\Debug\net10.0-windows\. The RID + self-contained single-file
         settings apply ONLY under publish (publish-app.ps1 passes
         -r win-x64 -p:_IsPublishing=true), so dev output stays RID-free. -->
  </PropertyGroup>

  <!-- Release publish: framework-dependent single-file exe (~1.5 MB). Needs the
       .NET 10 Desktop Runtime installed (the installer checks for it and warns)
       — small download instead of a ~50 MB bundled runtime per app. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceBase for the same exe's service mode (no generic-host stack) -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon art: colors are parsed from these at runtime (TrayIcons) -->
    <EmbeddedResource Include="assets\vpn-on.svg" />
    <EmbeddedResource Include="assets\vpn-off.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- script shim stays at the app root, next to VpncBar.exe (it relays to it) -->
    <None Include="assets\vpncbar-script.js" Link="vpncbar-script.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Both backends live in one output\backend\ folder: openconnect.exe +
       vpnc.exe + wintun.dll + the GnuTLS/etc DLL closure they share (one copy
       each — Windows resolves an exe's DLLs from its own directory). The merged
       set is produced by build-openconnect + build-vpnc (into dist\backend); the
       dev build copies it here so the local exe can run tunnels. Empty/absent
       until the backends are built — that's fine (the app just can't connect).
       A Target (not a None glob) is used: the '..\' source path defeats
       CopyToOutputDirectory's link-path inference.
       Skipped during publish: the release ships only the exe to dist\app and
       gets its backend from dist\backend (via the installer), so copying it
       into the publish intermediate would just waste ~17 MB. -->
  <Target Name="CopyBackend" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <BackendFile Include="..\dist\backend\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BackendFile)"
          DestinationFolder="$(OutDir)backend"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
