# build outputs
bin/
obj/
*.user
.vs/

# dist/ is build output (gitignored) — EXCEPT the installer source, which lives
# under dist/setup/ alongside the setup.exe it produces.
dist/*
!dist/setup/
dist/setup/*
!dist/setup/VpncBar.iss

# fetched / built / provisioned under vendor — regenerate with the root scripts:
#   fetch-wintun.ps1       -> vendor/wintun/bin
#   fetch-openconnect.ps1  -> dist/backend (+ vendor/openconnect/build tree)
#   build-vpnc.ps1         -> dist/backend
#   setup-msys.ps1         -> vendor/msys64 (the ~2-3 GB MSYS2 build toolchain)
# Both compiled backends land in dist/backend (covered by dist/* above).
# (vendor/openconnect/src/*.tar.gz IS committed: LGPL source provenance)
vendor/msys64/
vendor/openconnect/build/
vendor/wintun/bin/
# (vpnc builds in-place in vendor/vpnc/src — its build products are ignored
#  by vendor/vpnc/.gitignore)
