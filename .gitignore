# build outputs
bin/
obj/
*.user
.vs/

# dist/ is build output (gitignored) — EXCEPT the installer source, which lives
# under dist/setup/ alongside the setup.exe it produces.
dist/*
!dist/setup/
dist/setup/*
!dist/setup/VpncBar.iss

# fetched / built binaries — regenerate with the tools/ scripts:
#   tools/fetch-wintun.ps1       -> vendor/wintun/bin
#   tools/fetch-openconnect.ps1  -> vendor/engines/bin (+ openconnect/build tree)
#   tools/build-vpnc.ps1         -> vendor/engines/bin
# both backends land in ONE merged folder, vendor/engines/bin (the bundled set).
# (vendor/openconnect/src/*.tar.gz IS committed: LGPL source provenance)
vendor/openconnect/build/
vendor/wintun/bin/
vendor/engines/bin/
# (vpnc builds in-place in vendor/vpnc/src — its build products are ignored
#  by vendor/vpnc/.gitignore)
